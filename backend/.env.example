# Copy this file to ".env" and replace the placeholders with real values.
# Never commit .env — it is already listed in .gitignore.

# HTTP port the API server listens on.
PORT=5000

# MongoDB connection string.
# Examples:
#   Local:  mongodb://127.0.0.1:27017/helpdesk
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/helpdesk
MONGO_URI=mongodb://127.0.0.1:27017/helpdesk

# JWT signing secret. Must be a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# JWT token lifetime. Accepts any value supported by the `ms` library
# (e.g. "1d", "12h", "30m") or a numeric seconds value.
JWT_EXPIRES_IN=1d
